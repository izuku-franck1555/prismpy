# Data and output directories (local only)
data/
# Bundled package data ships with the wheel and is tracked
# in source: Beck 2023 KG raster + legend. Negation pattern
# re-includes the koppen package's data directory after the
# generic ``data/`` rule has filtered it out.
!src/prismpy/koppen/data/
!src/prismpy/koppen/data/**
data.zip
output/
output_BEFORE_refactor/
# Provenance output files (but NOT src/prismpy/provenance/ source code)
/provenance/

# Cache directories
.prismpy/
*.cache

# OS files
.DS_Store
Thumbs.db

# Local configuration (user-specific paths)
*_local.yaml
*_local.json

# Internal planning / contract / findings docs — local only, never
# pushed. Symmetric with the prismweb .gitignore. These files carry
# sprint scoping, deep-investigation findings, verification strategy,
# and role-specific notes that belong to the harness, not the public
# artifact.
*-CONTRACT.md
*-VERIFICATION-STRATEGY.md
*-EXPERIENCE.md
*-FINDINGS.md
*-PLAN.md
*-NOTES.md
*-RETROSPECTIVE.md

# Local-only sandbox directory for Stage-N architecture docs, sprint
# scoping, per-sprint sub-folders, and any harness-only files that do
# not match the suffix patterns above. Symmetric with prismweb/.gitignore.
.local/
.venv-py312/
.venv-build/

# Internal experiment / scratch configs + status docs — MUST NOT reach the
# public repo. Added after PROJECT_STATUS.md and the nrisk/uc2 demo configs
# were found tracked on the public `main`; these slipped the suffix patterns
# above. Root is reserved for packaging files (pyproject/README/requirements).
PROJECT_STATUS.md
nrisk_demo*
uc2_kano_*_baseline.yaml
# Transient run logs / captured stdout + underscore-prefixed root sandbox files
*.log
*.out
/_*
